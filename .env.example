# ── データベース ────────────────────────────────
# ローカル開発: postgresql://<user>:<password>@localhost:5432/seggr
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seggr"

# Neon / Supabase など接続プール(PgBouncer)を挟むサービスを使う場合のみ設定する。
# プール経由だと Prisma のマイグレーションが使うアドバイザリロックが効かないため、
# マイグレーションだけプールを通さない接続を使う。
# Neon ならホスト名から "-pooler" を取り除いたURL。
# DIRECT_DATABASE_URL=""

# ── NextAuth (Auth.js v5) ───────────────────────
# openssl rand -base64 32 で生成する
AUTH_SECRET=""

# Google Cloud Console の OAuth 2.0 クライアント
# 承認済みリダイレクトURI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── 開発用シード ────────────────────────────────
# ログインを許可するメールアドレス(Googleアカウント)。
# Google Cloud Console の OAuth 同意画面「テストユーザー」にも登録すること。
SEED_OWNER_EMAIL=""
SEED_TESTER_EMAIL=""
# テナント分離の確認用。別組織のOWNERにするアカウント(任意)
SEED_OTHER_ORG_EMAIL=""
