{
  "name": "seggr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --exclude \"tests/unit/*-db.test.ts\" --exclude tests/unit/auth-invitation.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy && prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:verify": "psql \"$DATABASE_URL\" -f tests/db/verify-constraints.sql",
    "db:reset": "prisma migrate reset --force",
    "db:check": "tsx scripts/check-db.ts",
    "test:db": "vitest run tests/unit/tax-db.test.ts tests/unit/auth-invitation.test.ts",
    "pdf:sample": "tsx scripts/pdf-sample.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-pdf/renderer": "^4.9.0",
    "next": "^16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.28",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
